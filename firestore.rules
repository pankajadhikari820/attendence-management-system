rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function membershipExists(orgId, uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/memberships/$(orgId));
    }

    function membershipData(orgId, uid) {
      return get(/databases/$(database)/documents/users/$(uid)/memberships/$(orgId)).data;
    }

    function isVerifiedMemberOfOrg(orgId) {
      return isVerified()
        && membershipExists(orgId, request.auth.uid)
        && membershipData(orgId, request.auth.uid).get('status', '') == 'active';
    }

    function isOrgCreator(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid;
    }

    function isOrgOwner(orgId) {
      return isVerifiedMemberOfOrg(orgId) && (
        membershipData(orgId, request.auth.uid).get('isOwner', false) == true ||
        membershipData(orgId, request.auth.uid).get('portalTier', 'member') == 'owner' ||
        membershipData(orgId, request.auth.uid).get('permissions', {}).get('canManageOrg', false) == true ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid)
      );
    }

    function hasOrgPerm(orgId, permKey) {
      return isOrgOwner(orgId) || (
        isVerifiedMemberOfOrg(orgId) &&
        membershipData(orgId, request.auth.uid).get('permissions', {}).get(permKey, false) == true
      );
    }

    // Public Contact Inquiries (write-only lead form; no public reads)
    match /contactInquiries/{inqId} {
      allow create: if incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() >= 3 && incoming().email.size() <= 160
        && incoming().message is string && incoming().message.size() >= 1 && incoming().message.size() <= 2000;
      allow read, update, delete: if false;
    }

    // Invitation Code Lookup Index (get by exact code only, never listable)
    match /invitationIndex/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if false;
      allow create: if isVerified() && isValidId(inviteCode)
        && incoming().orgId is string
        && (isOrgOwner(incoming().orgId) || hasOrgPerm(incoming().orgId, 'canManageMembers'));
      allow update: if isSignedIn() && isValidId(inviteCode)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status in ['accepted', 'revoked'];
      allow delete: if false;
    }

    // Global Users Root
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() && isValidId(userId)
        && incoming().uid == userId
        && incoming().email is string && incoming().email.size() <= 160
        && (
          request.auth.uid == userId ||
          (incoming().get('lastActiveOrgId', '') is string
            && isValidId(incoming().get('lastActiveOrgId', ''))
            && (
              isOrgOwner(incoming().lastActiveOrgId) ||
              hasOrgPerm(incoming().lastActiveOrgId, 'canManageMembers')
            ))
        );

      allow update: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'emailVerified', 'fcmToken', 'lastActiveOrgId', 'updatedAt'])
      );
      allow delete: if false;

      // Trusted Organization Memberships (Prevents self-escalation)
      match /memberships/{orgId} {
        allow get: if isSignedIn() && (
          request.auth.uid == userId ||
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers')
        );
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() && isValidId(orgId) && incoming().orgId == orgId && incoming().uid == userId && (
          // Org Creator creating their initial owner membership
          (isOrgCreator(orgId) && userId == request.auth.uid && incoming().isOwner == true && incoming().portalTier == 'owner') ||
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          // Member self-onboarding strictly locked to base 'member' tier with zero elevated permissions
          (request.auth.uid == userId
            && incoming().isOwner == false
            && incoming().portalTier == 'member'
            && incoming().status in ['pending', 'active']
            && incoming().get('permissions', {}).get('canManageOrg', false) == false
            && incoming().get('permissions', {}).get('canManageMembers', false) == false
            && incoming().get('permissions', {}).get('canTakeAttendance', false) == false
            && incoming().get('permissions', {}).get('canEditAttendance', false) == false
            && incoming().get('permissions', {}).get('canApproveLeaves', false) == false
            && incoming().get('permissions', {}).get('canApproveCorrections', false) == false
            && incoming().get('permissions', {}).get('canViewAuditLogs', false) == false)
        );

        allow update: if isVerified() && isValidId(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers')
        );

        allow delete: if isVerified() && isOrgOwner(orgId);
      }
    }

    // Multi-Tenant Organization Root
    match /organizations/{orgId} {
      // Exact Org ID get allowed for signed-in users joining via ORG-XXXXX; list blocked to prevent scraping
      allow get: if isSignedIn() && isValidId(orgId);
      allow list: if false;

      allow create: if isSignedIn() && isValidId(orgId)
        && incoming().orgId == orgId
        && incoming().ownerUid == request.auth.uid
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 140
        && incoming().plan == 'free';

      allow update: if isVerified() && isValidId(orgId) && (
        isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageOrg')
      );
      allow delete: if false;

      // Branches
      match /branches/{branchId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create: if (isOrgCreator(orgId) && incoming().orgId == orgId) || (
          isVerifiedMemberOfOrg(orgId) && (
            isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageBranches')
          )
        );
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageBranches')
        );
        allow delete: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageBranches');
      }

      // Departments
      match /departments/{deptId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create: if (isOrgCreator(orgId) && incoming().orgId == orgId) || (
          isVerifiedMemberOfOrg(orgId) && (
            isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageDepartments')
          )
        );
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageDepartments')
        );
        allow delete: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageDepartments');
      }

      // Designations & Permissions
      match /designations/{desId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create: if (isOrgCreator(orgId) && incoming().orgId == orgId) || (
          isVerifiedMemberOfOrg(orgId) && (
            isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageHierarchy')
          )
        );
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageHierarchy')
        );
        allow delete: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageHierarchy');
      }

      // Shifts
      match /shifts/{shiftId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create: if (isOrgCreator(orgId) && incoming().orgId == orgId) || (
          isVerifiedMemberOfOrg(orgId) && (
            isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageShifts')
          )
        );
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageShifts')
        );
        allow delete: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageShifts');
      }

      // Holidays
      match /holidays/{holidayId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create, update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageHolidays')
        );
        allow delete: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageHolidays');
      }

      // Organization Members
      match /members/{memberUid} {
        allow get: if isVerifiedMemberOfOrg(orgId) && (
          request.auth.uid == memberUid ||
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          hasOrgPerm(orgId, 'canTakeAttendance') ||
          hasOrgPerm(orgId, 'canEditAttendance') ||
          hasOrgPerm(orgId, 'canViewReports') ||
          hasOrgPerm(orgId, 'canExportData') ||
          hasOrgPerm(orgId, 'canApproveLeaves') ||
          hasOrgPerm(orgId, 'canApproveCorrections') ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('parentMemberId', '') == memberUid)
        );
        allow list: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          hasOrgPerm(orgId, 'canTakeAttendance') ||
          hasOrgPerm(orgId, 'canEditAttendance') ||
          hasOrgPerm(orgId, 'canViewReports') ||
          hasOrgPerm(orgId, 'canExportData') ||
          hasOrgPerm(orgId, 'canManageHierarchy') ||
          hasOrgPerm(orgId, 'canManageDepartments') ||
          hasOrgPerm(orgId, 'canManageBranches') ||
          hasOrgPerm(orgId, 'canApproveLeaves') ||
          hasOrgPerm(orgId, 'canApproveCorrections')
        );

        allow create: if isSignedIn() && incoming().orgId == orgId && incoming().uid == memberUid && (
          (isOrgCreator(orgId) && memberUid == request.auth.uid && incoming().isOwner == true) ||
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          (request.auth.uid == memberUid
            && incoming().isOwner == false
            && incoming().portalTier == 'member'
            && incoming().status in ['pending', 'active']
            && incoming().get('permissions', {}).get('canManageOrg', false) == false
            && incoming().get('permissions', {}).get('canManageMembers', false) == false
            && incoming().get('permissions', {}).get('canTakeAttendance', false) == false)
        );

        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          (request.auth.uid == memberUid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'qrTokenId', 'updatedAt'])
            && incoming().isOwner == existing().isOwner
            && incoming().portalTier == existing().portalTier
            && incoming().designationId == existing().designationId
            && incoming().status == existing().status)
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Opaque Revocable Member QR Tokens
      match /qrTokens/{tokenId} {
        allow get: if isVerifiedMemberOfOrg(orgId);
        allow list: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canTakeAttendance') || hasOrgPerm(orgId, 'canManageMembers');
        allow create: if isSignedIn() && incoming().orgId == orgId && (
          isOrgCreator(orgId) ||
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          incoming().memberUid == request.auth.uid
        );
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          existing().memberUid == request.auth.uid
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Invitations
      match /invitations/{inviteCode} {
        allow get: if isSignedIn() && isValidId(inviteCode);
        allow list: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageMembers');
        allow create: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canManageMembers');
        allow update: if isSignedIn() && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          (existing().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
            && incoming().acceptedByUid == request.auth.uid
            && incoming().status == 'accepted')
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Attendance Sessions
      match /attendanceSessions/{sessionId} {
        allow read: if isVerifiedMemberOfOrg(orgId);
        allow create, update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canTakeAttendance')
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Attendance Records (Deterministic ID prevents duplicates; base members cannot tamper)
      match /attendanceRecords/{recordId} {
        allow get, list: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canTakeAttendance') ||
          hasOrgPerm(orgId, 'canEditAttendance') ||
          hasOrgPerm(orgId, 'canViewReports') ||
          hasOrgPerm(orgId, 'canExportData') ||
          hasOrgPerm(orgId, 'canApproveCorrections') ||
          resource.data.memberUid == request.auth.uid
        );

        allow create: if isVerifiedMemberOfOrg(orgId)
          && incoming().orgId == orgId
          && incoming().status in ['present', 'absent', 'late', 'half_day', 'on_leave', 'holiday', 'weekly_off']
          && (
            isOrgOwner(orgId) ||
            hasOrgPerm(orgId, 'canTakeAttendance') ||
            hasOrgPerm(orgId, 'canEditAttendance') ||
            (hasOrgPerm(orgId, 'canApproveLeaves') && incoming().status == 'on_leave') ||
            hasOrgPerm(orgId, 'canApproveCorrections') ||
            (incoming().memberUid == request.auth.uid
              && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('policies', {}).get('allowSelfCheckIn', false) == true)
          );

        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canTakeAttendance') ||
          hasOrgPerm(orgId, 'canEditAttendance') ||
          hasOrgPerm(orgId, 'canApproveLeaves') ||
          hasOrgPerm(orgId, 'canApproveCorrections')
        );

        allow delete: if isOrgOwner(orgId);
      }

      // Leave Requests
      match /leaveRequests/{leaveId} {
        allow get, list: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canApproveLeaves') ||
          hasOrgPerm(orgId, 'canViewReports') ||
          resource.data.memberUid == request.auth.uid
        );
        allow create: if isVerifiedMemberOfOrg(orgId)
          && incoming().orgId == orgId
          && incoming().memberUid == request.auth.uid
          && incoming().status == 'pending'
          && incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 600;
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canApproveLeaves')
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Correction Requests
      match /correctionRequests/{corrId} {
        allow get, list: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canApproveCorrections') ||
          resource.data.memberUid == request.auth.uid
        );
        allow create: if isVerifiedMemberOfOrg(orgId)
          && incoming().orgId == orgId
          && incoming().memberUid == request.auth.uid
          && incoming().status == 'pending'
          && incoming().requestedStatus in ['present', 'late', 'half_day', 'on_leave']
          && incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 600;
        allow update: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || hasOrgPerm(orgId, 'canApproveCorrections')
        );
        allow delete: if isOrgOwner(orgId);
      }

      // Notifications (User-isolated inside Org)
      match /notifications/{notifId} {
        allow get, list: if isVerifiedMemberOfOrg(orgId) && (
          isOrgOwner(orgId) || resource.data.userId == request.auth.uid
        );
        allow create: if isVerifiedMemberOfOrg(orgId) && incoming().orgId == orgId && (
          isOrgOwner(orgId) ||
          hasOrgPerm(orgId, 'canTakeAttendance') ||
          hasOrgPerm(orgId, 'canEditAttendance') ||
          hasOrgPerm(orgId, 'canManageMembers') ||
          hasOrgPerm(orgId, 'canApproveLeaves') ||
          hasOrgPerm(orgId, 'canApproveCorrections') ||
          incoming().userId == request.auth.uid
        );
        allow update: if isVerifiedMemberOfOrg(orgId)
          && existing().userId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
        allow delete: if isOrgOwner(orgId) || (isVerifiedMemberOfOrg(orgId) && existing().userId == request.auth.uid);
      }

      // Anomalies
      match /anomalies/{anomalyId} {
        allow read: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canViewAuditLogs') || hasOrgPerm(orgId, 'canViewReports');
        allow create: if isVerifiedMemberOfOrg(orgId) && incoming().orgId == orgId;
        allow update: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canViewAuditLogs');
        allow delete: if false;
      }

      // Immutable Audit Logs
      match /auditLogs/{logId} {
        allow read: if isOrgOwner(orgId) || hasOrgPerm(orgId, 'canViewAuditLogs');
        allow create: if (isOrgCreator(orgId) || isVerifiedMemberOfOrg(orgId))
          && incoming().orgId == orgId
          && incoming().actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
