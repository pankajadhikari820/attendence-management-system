rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Identity & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'pankajadhikari820@gmail.com';
    }

    function isAdmin() {
      return isVerified() && (
        isBootstrappedAdmin() ||
        (userExists(request.auth.uid) && userData(request.auth.uid).role == 'admin' && userData(request.auth.uid).status == 'active')
      );
    }

    function isTeacher() {
      return isVerified() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'teacher' && userData(request.auth.uid).status == 'active';
    }

    function isStudent() {
      return isVerified() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'student' && userData(request.auth.uid).status == 'active';
    }

    // Users Collection (PII protected; self-promotion blocked)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin() || isTeacher());
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(userId)
        && incoming().uid == userId
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 160
        && incoming().role in ['admin', 'teacher', 'student']
        && incoming().status in ['active', 'inactive']
        && (
          isAdmin() ||
          (request.auth.uid == userId && (
            incoming().role == 'student' ||
            (isBootstrappedAdmin() && incoming().role == 'admin')
          ))
        );

      allow update: if isVerified() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'emailVerified', 'fcmToken', 'updatedAt'])
          && incoming().role == existing().role
          && incoming().status == existing().status
          && incoming().uid == existing().uid)
      );

      allow delete: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow get: if isVerified() && isValidId(studentId) && (request.auth.uid == studentId || isAdmin() || isTeacher());
      allow list: if isVerified() && (isAdmin() || isTeacher());

      allow create: if isSignedIn() && isValidId(studentId)
        && incoming().uid == studentId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().rollNumber is string && incoming().rollNumber.size() <= 40
        && incoming().email is string && incoming().email.size() <= 160
        && (isAdmin() || (request.auth.uid == studentId && incoming().status == 'active'));

      allow update: if isVerified() && isValidId(studentId) && (
        isAdmin() ||
        (request.auth.uid == studentId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow get: if isVerified() && isValidId(teacherId);
      allow list: if isVerified();

      allow create: if isAdmin() && isValidId(teacherId)
        && incoming().uid == teacherId
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().employeeId is string && incoming().employeeId.size() <= 40;

      allow update: if isVerified() && isValidId(teacherId) && (
        isAdmin() ||
        (request.auth.uid == teacherId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // Academic Reference Catalogs (Read by verified users, managed by Admin)
    match /departments/{deptId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(deptId)
        && incoming().code is string && incoming().code.size() <= 20
        && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(courseId)
        && incoming().code is string && incoming().code.size() <= 24
        && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(subjectId)
        && incoming().code is string && incoming().code.size() <= 24
        && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(classId)
        && incoming().code is string && incoming().code.size() <= 24
        && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin();
    }

    match /timetable/{slotId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(slotId)
        && incoming().classId is string && incoming().subjectId is string;
      allow delete: if isAdmin();
    }

    match /holidays/{holidayId} {
      allow read: if isVerified();
      allow create, update: if isAdmin() && isValidId(holidayId)
        && incoming().title is string && incoming().title.size() <= 140
        && incoming().date is string && incoming().date.size() <= 20;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Attendance Sessions
    match /attendanceSessions/{sessionId} {
      allow get: if isVerified() && isValidId(sessionId);
      allow list: if isVerified() && (isAdmin() || isTeacher());

      allow create: if (isTeacher() || isAdmin()) && isValidId(sessionId)
        && incoming().teacherId is string && incoming().teacherId.size() <= 128
        && (isAdmin() || incoming().teacherId == request.auth.uid)
        && incoming().classId is string && incoming().classId.size() <= 128
        && incoming().subjectId is string && incoming().subjectId.size() <= 128
        && incoming().mode in ['qr', 'manual']
        && incoming().status in ['active', 'closed'];

      allow update: if isVerified() && isValidId(sessionId) && (
        isAdmin() ||
        (isTeacher() && existing().teacherId == request.auth.uid) ||
        // Student QR scan may only increment presentCount by +1 while session is active
        (isStudent()
          && existing().status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['presentCount', 'updatedAt'])
          && incoming().presentCount == existing().presentCount + 1)
      );

      allow delete: if isAdmin();
    }

    // Attendance Records (Deterministic ID: {sessionId}_{studentUid} prevents duplicates)
    match /attendanceRecords/{recordId} {
      allow get: if isVerified() && (
        isAdmin() ||
        isTeacher() ||
        existing().studentUid == request.auth.uid
      );
      allow list: if isVerified() && (
        isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        resource.data.studentUid == request.auth.uid
      );

      allow create: if isVerified()
        && recordId == incoming().sessionId + '_' + incoming().studentUid
        && incoming().sessionId is string && incoming().sessionId.size() <= 128
        && incoming().studentUid is string && incoming().studentUid.size() <= 128
        && incoming().status in ['present', 'absent', 'late', 'excused']
        && incoming().method in ['qr', 'manual', 'correction', 'auto_close']
        && (
          isAdmin() ||
          (isTeacher() && incoming().teacherId == request.auth.uid) ||
          (isStudent()
            && incoming().studentUid == request.auth.uid
            && incoming().method == 'qr'
            && incoming().status == 'present'
            && exists(/databases/$(database)/documents/attendanceSessions/$(incoming().sessionId))
            && get(/databases/$(database)/documents/attendanceSessions/$(incoming().sessionId)).data.status == 'active')
        );

      allow update: if isVerified() && (
        isAdmin() ||
        (isTeacher() && existing().teacherId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'method', 'markedBy', 'updatedAt'])
          && incoming().status in ['present', 'absent', 'late', 'excused'])
      );

      allow delete: if isAdmin();
    }

    // Leave Requests
    match /leaveRequests/{leaveId} {
      allow get: if isVerified() && (isAdmin() || isTeacher() || existing().studentUid == request.auth.uid);
      allow list: if isVerified() && (isAdmin() || isTeacher() || resource.data.studentUid == request.auth.uid);

      allow create: if isVerified() && isValidId(leaveId)
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 600;

      allow update: if isVerified() && isValidId(leaveId) && (
        isAdmin() ||
        (isTeacher()
          && existing().status == 'pending'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote', 'updatedAt'])
          && incoming().status in ['approved', 'rejected'])
      );

      allow delete: if isAdmin();
    }

    // Correction Requests
    match /correctionRequests/{correctionId} {
      allow get: if isVerified() && (isAdmin() || isTeacher() || existing().studentUid == request.auth.uid);
      allow list: if isVerified() && (isAdmin() || isTeacher() || resource.data.studentUid == request.auth.uid);

      allow create: if isVerified() && isValidId(correctionId)
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().requestedStatus in ['present', 'excused']
        && incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 600;

      allow update: if isVerified() && isValidId(correctionId) && (
        isAdmin() ||
        (isTeacher()
          && existing().status == 'pending'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote', 'updatedAt'])
          && incoming().status in ['approved', 'rejected'])
      );

      allow delete: if isAdmin();
    }

    // Notifications (User-isolated)
    match /notifications/{notificationId} {
      allow get: if isVerified() && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerified() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isVerified()
        && incoming().userId is string && incoming().userId.size() <= 128
        && incoming().title is string && incoming().title.size() <= 160
        && incoming().message is string && incoming().message.size() <= 600
        && (isAdmin() || isTeacher() || incoming().userId == request.auth.uid);

      allow update: if isVerified()
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
        && incoming().read is bool;

      allow delete: if isAdmin() || (isVerified() && existing().userId == request.auth.uid);
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isVerified();
      allow create, update, delete: if isAdmin();
    }

    // Audit Logs (Append-only for verified users; readable only by Admin)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isVerified()
        && incoming().actorUid == request.auth.uid
        && incoming().action is string && incoming().action.size() <= 80
        && incoming().entityType is string && incoming().entityType.size() <= 60;
      allow update, delete: if false;
    }
  }
}
