{
  "entities": {
    "User": {
      "title": "User",
      "description": "Global authenticated user profile (no passwords stored).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "emailVerified": { "type": "boolean" },
        "lastActiveOrgId": { "type": "string", "maxLength": 32 },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] }
      },
      "required": ["uid", "name", "email", "status"]
    },
    "UserMembership": {
      "title": "UserMembership",
      "description": "Trusted per-organization membership and resolved capabilities stored under users/{uid}/memberships/{orgId}.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 32 },
        "orgName": { "type": "string", "maxLength": 140 },
        "orgType": { "type": "string", "maxLength": 32 },
        "uid": { "type": "string", "maxLength": 128 },
        "memberPublicId": { "type": "string", "maxLength": 40 },
        "designationId": { "type": "string", "maxLength": 128 },
        "designationName": { "type": "string", "maxLength": 100 },
        "branchId": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 128 },
        "isOwner": { "type": "boolean" },
        "portalTier": { "type": "string", "enum": ["owner", "manager", "member"] },
        "permissions": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "pending", "inactive", "rejected"] }
      },
      "required": ["orgId", "uid", "portalTier", "status"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant organization root workspace (School, College, Company, Office, Startup, Factory, etc.).",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 140 },
        "type": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "country": { "type": "string", "maxLength": 80 },
        "timezone": { "type": "string", "maxLength": 80 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "memberLimit": { "type": "number" },
        "branchLimit": { "type": "number" },
        "policies": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      },
      "required": ["orgId", "name", "type", "ownerUid", "plan", "status"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Organization campus, office branch, plant, or site.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "code": { "type": "string", "maxLength": 24 },
        "address": { "type": "string", "maxLength": 300 },
        "managerUid": { "type": "string" },
        "geofence": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["orgId", "name", "code"]
    },
    "Department": {
      "title": "Department",
      "description": "Organization department, team, division, or class cohort.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string", "maxLength": 120 },
        "code": { "type": "string", "maxLength": 24 },
        "branchId": { "type": "string" },
        "headUid": { "type": "string" },
        "description": { "type": "string", "maxLength": 400 }
      },
      "required": ["orgId", "name", "code"]
    },
    "Designation": {
      "title": "Designation",
      "description": "Unlimited custom hierarchy role with level, parent designation, and capability flags.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "level": { "type": "number" },
        "parentDesignationId": { "type": "string" },
        "isSystemOwner": { "type": "boolean" },
        "permissions": { "type": "object" }
      },
      "required": ["orgId", "name", "level", "permissions"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Attendance schedule with start/end times, grace window, and half-day threshold.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "lateGraceMinutes": { "type": "number" },
        "halfDayThresholdMinutes": { "type": "number" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["orgId", "name", "startTime", "endTime"]
    },
    "Holiday": {
      "title": "Holiday",
      "description": "Public, institutional, or department holiday excluded from absence denominators.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "title": { "type": "string", "maxLength": 140 },
        "date": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "enum": ["public", "org", "optional"] },
        "departmentId": { "type": "string" }
      },
      "required": ["orgId", "title", "date"]
    },
    "OrgMember": {
      "title": "OrgMember",
      "description": "Organization member with immutable SA-ORGXXXXX-YYYYYY ID, reporting parent, and revocable QR token reference.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "orgId": { "type": "string" },
        "memberPublicId": { "type": "string" },
        "externalId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "designationId": { "type": "string" },
        "designationName": { "type": "string" },
        "branchId": { "type": "string" },
        "departmentId": { "type": "string" },
        "shiftId": { "type": "string" },
        "parentMemberId": { "type": "string" },
        "qrTokenId": { "type": "string" },
        "isOwner": { "type": "boolean" },
        "portalTier": { "type": "string", "enum": ["owner", "manager", "member"] },
        "permissions": { "type": "object" },
        "leaveBalance": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "pending", "inactive", "rejected"] }
      },
      "required": ["uid", "orgId", "memberPublicId", "name", "email", "status"]
    },
    "QrToken": {
      "title": "QrToken",
      "description": "Opaque revocable QR token mapping inside an organization (zero PII inside QR code).",
      "type": "object",
      "properties": {
        "tokenId": { "type": "string" },
        "orgId": { "type": "string" },
        "memberUid": { "type": "string" },
        "memberPublicId": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["tokenId", "orgId", "memberUid", "active"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Organization onboarding invite code.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "email": { "type": "string" },
        "designationId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "expiresAtMs": { "type": "number" }
      },
      "required": ["orgId", "inviteCode", "status"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Named organization attendance session for scanning or batch marking.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "branchId": { "type": "string" },
        "departmentId": { "type": "string" },
        "shiftId": { "type": "string" },
        "startedByUid": { "type": "string" },
        "date": { "type": "string" },
        "mode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] }
      },
      "required": ["orgId", "title", "startedByUid", "date", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Deterministic daily/session attendance record ({date}__{scope}__{memberUid}).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "sessionId": { "type": "string" },
        "date": { "type": "string" },
        "memberUid": { "type": "string" },
        "memberPublicId": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "late", "half_day", "on_leave", "holiday", "weekly_off"] },
        "method": { "type": "string" },
        "checkInMs": { "type": "number" },
        "checkOutMs": { "type": "number" },
        "lateMinutes": { "type": "number" },
        "workingMinutes": { "type": "number" },
        "overtimeMinutes": { "type": "number" },
        "markedByUid": { "type": "string" }
      },
      "required": ["orgId", "date", "memberUid", "status"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Member leave application synced to attendanceRecords upon approval.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "memberUid": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "reason": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["orgId", "memberUid", "startDate", "endDate", "reason", "status"]
    },
    "CorrectionRequest": {
      "title": "CorrectionRequest",
      "description": "Member request to update a recorded attendance entry.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "recordId": { "type": "string" },
        "date": { "type": "string" },
        "memberUid": { "type": "string" },
        "requestedStatus": { "type": "string", "enum": ["present", "late", "half_day", "on_leave"] },
        "reason": { "type": "string" },
        "evidenceUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["orgId", "memberUid", "requestedStatus", "reason", "status"]
    },
    "Anomaly": {
      "title": "Anomaly",
      "description": "Security anomaly log (cross-org QR scan, revoked QR, duplicate scan, geofence violation).",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "type": { "type": "string" },
        "scannerUid": { "type": "string" },
        "memberUid": { "type": "string" },
        "details": { "type": "string" },
        "resolved": { "type": "boolean" }
      },
      "required": ["orgId", "type", "details"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational audit entry recording actor, action, and before/after diffs.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "before": { "type": "string" },
        "after": { "type": "string" }
      },
      "required": ["orgId", "actorUid", "action", "entityType"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Global user profiles." },
    "/users/{userId}/memberships/{orgId}": { "schema": { "$ref": "#/entities/UserMembership" }, "description": "Trusted org memberships & capabilities." },
    "/invitationIndex/{inviteCode}": { "schema": { "$ref": "#/entities/Invitation" }, "description": "Non-listable invite lookup index." },
    "/organizations/{orgId}": { "schema": { "$ref": "#/entities/Organization" }, "description": "Organization tenant root." },
    "/organizations/{orgId}/branches/{branchId}": { "schema": { "$ref": "#/entities/Branch" }, "description": "Organization branches." },
    "/organizations/{orgId}/departments/{deptId}": { "schema": { "$ref": "#/entities/Department" }, "description": "Organization departments." },
    "/organizations/{orgId}/designations/{desId}": { "schema": { "$ref": "#/entities/Designation" }, "description": "Custom hierarchy designations." },
    "/organizations/{orgId}/shifts/{shiftId}": { "schema": { "$ref": "#/entities/Shift" }, "description": "Shift policies." },
    "/organizations/{orgId}/holidays/{holidayId}": { "schema": { "$ref": "#/entities/Holiday" }, "description": "Non-working holidays." },
    "/organizations/{orgId}/members/{memberUid}": { "schema": { "$ref": "#/entities/OrgMember" }, "description": "Tenant member profiles." },
    "/organizations/{orgId}/qrTokens/{tokenId}": { "schema": { "$ref": "#/entities/QrToken" }, "description": "Opaque revocable QR tokens." },
    "/organizations/{orgId}/invitations/{inviteCode}": { "schema": { "$ref": "#/entities/Invitation" }, "description": "Org invitations." },
    "/organizations/{orgId}/attendanceSessions/{sessionId}": { "schema": { "$ref": "#/entities/AttendanceSession" }, "description": "Attendance sessions." },
    "/organizations/{orgId}/attendanceRecords/{recordId}": { "schema": { "$ref": "#/entities/AttendanceRecord" }, "description": "Deterministic attendance records." },
    "/organizations/{orgId}/leaveRequests/{leaveId}": { "schema": { "$ref": "#/entities/LeaveRequest" }, "description": "Leave applications." },
    "/organizations/{orgId}/correctionRequests/{corrId}": { "schema": { "$ref": "#/entities/CorrectionRequest" }, "description": "Attendance correction requests." },
    "/organizations/{orgId}/anomalies/{anomalyId}": { "schema": { "$ref": "#/entities/Anomaly" }, "description": "Security & scan anomaly logs." },
    "/organizations/{orgId}/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Immutable operational audit trail." }
  }
}
