{
  "rules": {
    ".read": false,
    ".write": false,
    "orgLive": {
      "$orgId": {
        "sessions": {
          "$sessionId": {
            ".read": "auth != null && auth.token.email_verified == true",
            ".write": "auth != null && auth.token.email_verified == true && (!data.exists() || data.child('startedByUid').val() == auth.uid)"
          }
        },
        "recentScans": {
          ".read": "auth != null && auth.token.email_verified == true",
          "$memberUid": {
            ".write": "auth != null && auth.token.email_verified == true"
          }
        }
      }
    }
  }
}
